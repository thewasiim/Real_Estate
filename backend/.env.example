# Public URL where the frontend is served (no trailing slash)
FRONTEND_URL="http://localhost:5173"

# SMTP settings used only for password-reset email delivery
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-username"
SMTP_PASSWORD="smtp-password"
SMTP_FROM="F.B. Developer <no-reply@example.com>"
